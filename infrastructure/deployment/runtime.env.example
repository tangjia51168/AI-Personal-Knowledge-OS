# Copy outside the source checkout; chmod 600 / restrict Windows ACL. Never commit real values.
APP_ENV=production
DATABASE_URL=postgresql+psycopg://knowledge_app:CHANGE_ME@postgres.internal:5432/knowledge_os
REDIS_URL=rediss://default:CHANGE_ME@redis.internal:6379/0?ssl_cert_reqs=required&ssl_check_hostname=true
S3_ENDPOINT_URL=https://objects.example.com
S3_ACCESS_KEY=CHANGE_ME_scoped_runtime_identity
S3_SECRET_KEY=CHANGE_ME_independent_32_random_characters
S3_SESSION_TOKEN=
S3_BUCKET=knowledge-os
S3_REGION=us-east-1
SYSTEM_API_TOKEN=CHANGE_ME_independent_32_random_characters
DOWNLOAD_SIGNING_KEY=CHANGE_ME_another_independent_32_random_characters
CREDENTIAL_KEYS={"v1":"CHANGE_ME_base64_32_random_bytes"}
CREDENTIAL_ACTIVE_KEY=v1
PUBLIC_APP_URL=https://knowledge.example.com
CORS_ORIGINS=["https://knowledge.example.com"]
TRUSTED_HOSTS=["api","knowledge.example.com"]
REGISTRATION_ENABLED=false
EMAIL_VERIFICATION_REQUIRED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
OPENAI_ENABLED=false
DEEPSEEK_ENABLED=false
COLLECTOR_ENABLED=false
OLLAMA_ENDPOINTS={}
LOCAL_EMBEDDING_ENDPOINT=
# No MIGRATION_DATABASE_URL in this file. URL passwords must be percent-encoded.
