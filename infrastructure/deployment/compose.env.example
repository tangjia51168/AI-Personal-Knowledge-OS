# Compose substitution only; do not use runtime/migration env files for this purpose.
KOS_API_IMAGE=registry.example.com/knowledge-os/api@sha256:CHANGE_ME
KOS_WEB_IMAGE=registry.example.com/knowledge-os/web@sha256:CHANGE_ME
KOS_GATEWAY_IMAGE=registry.example.com/knowledge-os/gateway@sha256:CHANGE_ME
KOS_RUNTIME_ENV=/secure/knowledge-os/runtime.env
KOS_MIGRATION_ENV=/secure/knowledge-os/migration.env
KOS_GATEWAY_CONFIG=/secure/knowledge-os/nginx.conf
KOS_TLS_CERT=/secure/knowledge-os/fullchain.pem
KOS_TLS_KEY=/secure/knowledge-os/privkey.pem
# Loopback by default. Change only after public release gates pass.
KOS_BIND_ADDRESS=127.0.0.1
# Optional production-embedding overlay. Fixed model files must match model.json hashes.
KOS_EMBEDDING_IMAGE=registry.example.com/knowledge-os/embedding@sha256:CHANGE_ME
KOS_EMBEDDING_MODELS=/secure/knowledge-os/models
