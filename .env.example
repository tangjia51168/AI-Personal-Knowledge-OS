# Copy to .env. Replace every CHANGE_ME value before starting Compose.
POSTGRES_USER=knowledge_admin
POSTGRES_PASSWORD=CHANGE_ME_admin_password
POSTGRES_DB=knowledge_os
APP_DB_PASSWORD=CHANGE_ME_application_password
DATABASE_URL=postgresql+psycopg://knowledge_app:CHANGE_ME_application_password@localhost:5432/knowledge_os
MIGRATION_DATABASE_URL=postgresql+psycopg://knowledge_admin:CHANGE_ME_admin_password@localhost:5432/knowledge_os
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=CHANGE_ME_minio_user
S3_SECRET_KEY=CHANGE_ME_minio_password
# Optional short-lived STS credential; empty for a dedicated long-lived runtime user.
S3_SESSION_TOKEN=
S3_BUCKET=knowledge-os
S3_REGION=us-east-1
# Operator diagnostics only; NOT a user login or a browser-visible token.
SYSTEM_API_TOKEN=CHANGE_ME_generate_at_least_32_random_characters
# Dedicated download ticket key. Rotation invalidates all outstanding 60-second tickets.
DOWNLOAD_SIGNING_KEY=CHANGE_ME_generate_a_different_32_character_secret
API_BASE_URL=http://localhost:8000
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000"]
# Credential vault intentionally disabled until operator injects a private keyring.
# JSON mapping version -> base64-encoded 32 random bytes. Never commit actual values.
CREDENTIAL_KEYS=
CREDENTIAL_ACTIVE_KEY=v1
# Operator-named, explicitly authorized local model endpoints only; empty by default.
OLLAMA_ENDPOINTS={}
# Set true only after choosing a model and authorizing cloud costs.
OPENAI_ENABLED=false
DEEPSEEK_ENABLED=false
# Explicit public URL collection only; no automatic crawling or platform cookies.
COLLECTOR_ENABLED=false
# Optional local acceptance operator credential; never exposed to browser automatically.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional local DeepSeek acceptance credential; tenant keys are configured through the API/UI.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
REGISTRATION_ENABLED=true
TRUSTED_HOSTS=["localhost","127.0.0.1","api"]
EMAIL_VERIFICATION_REQUIRED=false
PUBLIC_APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
